# Copy this file to .env and fill in your own values.
# Never commit .env or a real API key.
DASHSCOPE_API_KEY=sk-your-api-key
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=automotive_erp_agent
ERP_BASE_URL=http://127.0.0.1:8081
MCP_SERVER_URL=http://localhost:9000
SANDBOX_IMAGE=python:3.11-slim
CORS_ORIGINS=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=8000

# ===== 钉钉分级告警 =====
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
DINGTALK_DRY_RUN=true
DINGTALK_RETRY_ATTEMPTS=3
DINGTALK_RETRY_BASE_DELAY=1
DINGTALK_TIMEOUT_SECONDS=10
ALERT_SCHEDULER_ENABLED=true
ALERT_SCAN_INTERVAL_SECONDS=60
APPROVAL_TIMEOUT_MINUTES=60
APPROVAL_CRITICAL_MULTIPLIER=2
APPROVAL_CRITICAL_AMOUNT=50000
ALERT_DEDUPE_COOLDOWN_SECONDS=86400
ALERT_STATE_DB=data/alert_state.db
